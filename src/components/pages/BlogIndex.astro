---
import { getCollection } from 'astro:content';
import type { Locale } from '../../i18n/ui';
import { useTranslations, localePath, parsePostId } from '../../i18n/utils';
import BaseHead from '../BaseHead.astro';
import Footer from '../Footer.astro';
import Header from '../Header.astro';
import FormattedDate from '../FormattedDate.astro';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (await getCollection('blog'))
	.filter((p) => parsePostId(p.id).lang === lang)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={t('site.title')} description={t('site.description')} lang={lang} />
		<style>
			main {
				width: 800px;
				max-width: 100%;
			}
			.post-list {
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.post-item {
				margin-bottom: 2rem;
				padding-bottom: 2rem;
				border-bottom: 1px solid var(--gray-light);
			}
			.post-item:last-child {
				border-bottom: none;
			}
			.post-item a {
				display: flex;
				flex-direction: column;
				text-decoration: none;
				gap: 0.25rem;
			}
			.title {
				margin: 0;
				color: var(--black);
				line-height: 1.3;
				font-size: 1.5rem;
				font-weight: 700;
				transition: color 0.2s ease;
			}
			.post-item a:hover .title {
				color: var(--accent);
			}
			.date {
				margin: 0;
				color: var(--gray);
				font-size: 0.9rem;
				font-family: ui-monospace, SFMono-Regular, monospace;
			}
			.description {
				margin: 0.5rem 0 0;
				color: var(--gray-dark);
				font-size: 1.1rem;
				line-height: 1.6;
			}

			@media (prefers-color-scheme: dark) {
				.post-item {
					border-bottom-color: rgba(51, 65, 85, 0.5);
				}
			}
		</style>
	</head>
	<body>
		<Header lang={lang} />
		<main>
			<section>
				<ul class="post-list">
					{
						posts.map((post) => {
							const { slug } = parsePostId(post.id);
							return (
								<li class="post-item">
									<a href={localePath(`/blog/${slug}/`, lang)}>
										<p class="date">
											<FormattedDate date={post.data.pubDate} lang={lang} />
										</p>
										<h2 class="title">{post.data.title}</h2>
										{post.data.description && (
											<p class="description">{post.data.description}</p>
										)}
									</a>
								</li>
							);
						})
					}
				</ul>
			</section>
		</main>
		<Footer lang={lang} />
	</body>
</html>
